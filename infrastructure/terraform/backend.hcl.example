# Copy to backend.hcl (gitignored) and fill in values for local dev.
# CI passes these via -backend-config flags directly (see .github/workflows/ci.yml).
#
# Usage:
#   terraform init -backend-config=backend.hcl -var-file=env/dev.tfvars

bucket       = "event-discovery-platform-dev-tfstate"
key          = "edp/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true
encrypt      = true
profile      = "claude-dev"
